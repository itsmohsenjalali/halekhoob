# Alternative configuration for a standalone PostgreSQL/R2 worker.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=archive.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://archive.example.com:8443
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Maintenance host only; use a direct (non-pooler) URL for migrations/import/export.
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
MEDIA_BACKEND=r2
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-private-bucket
R2_PREFIX=archive
R2_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_SECRET
R2_URL_TTL=3600
# Includes retained deletions and pending uploads; not an R2 billing hard limit.
ARCHIVE_MAX_BYTES=100000000000
# Worker data directory.
DATA_DIR=/data
MIN_FREE_BYTES=2000000000
DOWNLOAD_TIMEOUT=1800
