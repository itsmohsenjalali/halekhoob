# Add as a separate vhost in your existing ingress. Replace the domain and
# upstream host gateway address. Keep existing sites' server blocks unchanged.
server {
    listen 80;
    server_name archive.example.com;
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 308 https://archive.example.com$request_uri;
    }
}
server {
    listen 443 ssl;
    server_name archive.example.com;
    ssl_certificate /etc/letsencrypt/halekhoob/archive.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/halekhoob/archive.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    location / {
        # Use a stable host gateway address reachable from the ingress container.
        proxy_pass https://172.17.0.1:8443;
        proxy_ssl_server_name on;
        proxy_ssl_name archive.example.com;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_http_version 1.1;
        proxy_set_header Host archive.example.com;
        proxy_set_header X-Forwarded-Host archive.example.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 65s;
        proxy_buffering off;
    }
}
