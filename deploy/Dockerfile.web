FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements-server.txt ./
RUN pip install --no-cache-dir -r requirements-server.txt
COPY backend/config ./config
COPY backend/library ./library
COPY backend/templates ./templates
COPY backend/static ./static
COPY backend/theme ./theme
COPY backend/tokens.css ./
COPY backend/manage.py ./
RUN DJANGO_DEBUG=1 DATA_DIR=/tmp/build-data python manage.py collectstatic --noinput --verbosity 0 \
    && rm -rf /tmp/build-data \
    && useradd --create-home --uid 10001 archive
USER archive
ENV DATA_DIR=/tmp/app-data
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--threads", "2", "--timeout", "60", "--forwarded-allow-ips", "*", "--access-logfile", "-", "--error-logfile", "-"]
