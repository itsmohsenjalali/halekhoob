# Copy to .env.server (mode 600). Passwords generated by init_server_env.py are URL-safe.
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_VALUE
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
# Loopback binding works through SSH without changing the host's Nginx.
APP_BIND_HOST=127.0.0.1
APP_PORT=8088
APP_PUBLIC_URL=http://127.0.0.1:8088
PROXY_SCHEME=http
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=halekhoob-media
R2_PREFIX=archive
R2_WEB_ACCESS_KEY_ID=REPLACE_WITH_READ_ONLY_KEY
R2_WEB_SECRET_ACCESS_KEY=REPLACE_WITH_READ_ONLY_SECRET
R2_WORKER_ACCESS_KEY_ID=REPLACE_WITH_READ_WRITE_KEY
R2_WORKER_SECRET_ACCESS_KEY=REPLACE_WITH_READ_WRITE_SECRET
R2_URL_TTL=3600
ARCHIVE_MAX_BYTES=8000000000

# Optional dedicated HTTPS listener (requires a certificate before starting gateway):
ENABLE_TLS=0
TLS_DOMAIN=your-domain.example
TLS_PORT=8443
TLS_BIND_HOST=0.0.0.0
# Existing Nginx ACME webroot volume; never use its certificate volume.
ACME_WEBROOT_VOLUME=existing_certbot_www
